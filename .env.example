# Copy these names into Hostinger → your Node.js app → Environment variables.
# Never put real values in this file or in GitHub.

# The live web address, used for links in emails and for Google.
SITE_URL=https://tbossphotography.com

# Resend (automatic emails). Leave empty until Phase 1 email is set up:
# the contact form still works and logs enquiries instead of emailing.
RESEND_API_KEY=
# The address emails come from (must be on the domain verified in Resend).
EMAIL_FROM=Tboss Photography <hello@tbossphotography.com>
# Where new enquiries are sent.
STUDIO_INBOX=hello@tbossphotography.com

# Set to 1 only on a preview copy to show the sample Journal stories.
SHOW_SAMPLES=
