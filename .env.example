# Copy these NAMES into Hostinger → your Node.js app → Environment variables,
# with the real values next to them. Never put real values in this file or in GitHub.

# ---- Website ----
SITE_URL=https://tbossphotography.com

# ---- Sign-in (Phase 2) ----
# A long random secret that keeps sign-ins safe. 40+ characters, letters and numbers.
SESSION_SECRET=
# Google Cloud → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts that can open the studio admin, separated by commas.
ADMIN_EMAILS=

# ---- Database (Phase 2) ---- from hPanel → Databases
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Photo storage (Phase 2) ---- Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tboss-galleries

# ---- Email (optional until set up) ---- Resend
# Without it, forms and gallery emails still work but are recorded in the app log instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Tboss Photography <hello@tbossphotography.com>
STUDIO_INBOX=hello@tbossphotography.com

# ---- Reminders (Phase 3) ----
# A made-up secret. Hostinger's cron job calls /api/cron/daily?key=THIS_VALUE once a day.
CRON_SECRET=

# ---- Instagram & AI (Phase 4) ----
# Instagram long-lived token from Meta for Developers. The site renews it automatically.
INSTAGRAM_TOKEN=
# Anthropic API key for Journal drafts.
ANTHROPIC_API_KEY=
# Optional: which Claude model writes the drafts.
ANTHROPIC_MODEL=claude-sonnet-5-5
